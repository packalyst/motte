            "DELETE"
          ],
          "handler": "DeleteEntry",
          "description": "Delete firewall entry"
        },
        {
          "path": "/entries/{id}/toggle",
          "methods": [
            "POST"
          ],
          "handler": "ToggleEntry",
          "description": "Toggle entry enabled/disabled"
        },
        {
          "path": "/entries/bulk",
          "methods": [
            "POST"
          ],
          "handler": "BulkEntries",
