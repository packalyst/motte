# Traefik Dynamic Configuration
http:
  routers:
    # UI - catch all for main host only - HTTP
    ui:
      rule: "(Host(`${SERVER_IP}`) || Host(`${ADMIN_DOMAIN}`)) && PathPrefix(`/`)"
      service: ui
      priority: 10
      middlewares:
        - security-headers
        - sentinel_fw_block
      entryPoints:
        - web

    # Unified API - all /api/* routes (except /api/v1 for headscale direct) - HTTP
    unified-api:
      rule: "(Host(`${SERVER_IP}`) || Host(`${ADMIN_DOMAIN}`)) && PathPrefix(`/api/`) && !PathPrefix(`/api/v1`)"
      service: unified-api
      priority: 100
      middlewares:
        - rate-limit
        - security-headers
        - sentinel_fw_block
      entryPoints:
        - web

    # Headscale control plane - HTTP (for Tailscale clients)
    # Includes /derp for DERP relay connections and /register for node registration
    headscale-control:
      rule: "(Host(`${SERVER_IP}`) || Host(`${ADMIN_DOMAIN}`)) && (PathPrefix(`/ts2021`) || PathPrefix(`/machine`) || PathPrefix(`/key`) || PathPrefix(`/noise`) || PathPrefix(`/derp`) || PathPrefix(`/register`) || PathPrefix(`/apple`) || PathPrefix(`/windows`))"
      service: headscale
      priority: 100
      entryPoints:
        - web

    # Headscale control plane - HTTPS (Tailscale clients try HTTPS first)
    headscale-control-secure:
      rule: "(Host(`${SERVER_IP}`) || Host(`${ADMIN_DOMAIN}`)) && (PathPrefix(`/ts2021`) || PathPrefix(`/machine`) || PathPrefix(`/key`) || PathPrefix(`/noise`) || PathPrefix(`/derp`) || PathPrefix(`/register`) || PathPrefix(`/apple`) || PathPrefix(`/windows`))"
      service: headscale
      priority: 100
      entryPoints:
        - websecure
      tls: {}

    # Headscale API - BLOCKED for external access (UI uses /api/hs via unified API)
    # This prevents direct API access - all admin goes through unified API with server-side auth
    headscale-api-blocked:
      rule: "(Host(`${SERVER_IP}`) || Host(`${ADMIN_DOMAIN}`)) && PathPrefix(`/api/v1`)"
      service: headscale
      priority: 100
      middlewares:
        - sentinel_vpn
        - rate-limit-strict
        - security-headers
      entryPoints:
        - web

    # Block PWA files on non-main domains (prevent Chrome install prompt on other domains)
    block-pwa-catchall:
      rule: "!Host(`${SERVER_IP}`) && !Host(`${ADMIN_DOMAIN}`) && (Path(`/manifest.json`) || Path(`/sw.js`) || Path(`/icon.svg`))"
      service: ui
      priority: 5
      middlewares:
        - sentinel_drop
      entryPoints:
        - web

    block-pwa-catchall-secure:
      rule: "!Host(`${SERVER_IP}`) && !Host(`${ADMIN_DOMAIN}`) && (Path(`/manifest.json`) || Path(`/sw.js`) || Path(`/icon.svg`))"
      service: ui
      priority: 5
      middlewares:
        - sentinel_drop
      entryPoints:
        - websecure
      tls: {}

    # Catchall for unmatched domains - lowest priority
    # Any domain not configured will get dropped silently
    catchall-drop:
      rule: "PathPrefix(`/`)"
      service: ui
      priority: 1
      middlewares:
        - sentinel_drop
      entryPoints:
        - web

    catchall-drop-secure:
      rule: "PathPrefix(`/`)"
      service: ui
      priority: 1
      middlewares:
        - sentinel_drop
      entryPoints:
        - websecure
      tls: {}

  services:
    ui:
      loadBalancer:
        servers:
          - url: "http://ui:80"

    unified-api:
      loadBalancer:
        servers:
          - url: "http://host.docker.internal:${API_PORT}"

    headscale:
      loadBalancer:
        servers:
          - url: "http://headscale:8080"

  middlewares:
    # Rate limiting - requests per second average, burst
    rate-limit:
      rateLimit:
        average: ${RATE_LIMIT_AVERAGE}
        burst: ${RATE_LIMIT_BURST}

    # Strict rate limiting for sensitive APIs
    rate-limit-strict:
      rateLimit:
        average: ${RATE_LIMIT_STRICT_AVERAGE}
        burst: ${RATE_LIMIT_STRICT_BURST}

    # Security headers
    security-headers:
      headers:
        frameDeny: true
        contentTypeNosniff: true
        browserXssFilter: true
        referrerPolicy: "strict-origin-when-cross-origin"
        # Content-Security-Policy: the backstop that neuters XSS. script-src 'self' allows
        # NO inline scripts (the page carries none — the SW registration lives in main.js),
        # so an injected <script> or inline handler is blocked. style-src keeps 'unsafe-inline'
        # (Svelte/Tailwind inject inline styles — not a script-exec vector); img-src allows
        # https for the Leaflet map tiles; connect-src allows the same-origin API + websocket.
        # frame-ancestors 'none' is the modern clickjacking guard (matches frameDeny).
        # NOTE: if a bundled lib ever needs eval, add 'unsafe-eval' to script-src.
        # connect-src must list the external hosts the app loads resources from, because the
        # service worker (public/sw.js) re-fetches every request via fetch() — so even <img>
        # tiles/flags become connect-src, not img-src. Hosts: flagcdn.com (country flags),
        # *.tile.openstreetmap.org (Leaflet map tiles), unpkg.com (Leaflet CSS + marker icons).
        # style-src adds unpkg.com for the externally-loaded Leaflet stylesheet.
        contentSecurityPolicy: "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://unpkg.com; script-src 'self'; connect-src 'self' ws: wss: https://flagcdn.com https://unpkg.com https://*.tile.openstreetmap.org; font-src 'self' data:"
        # HSTS: browsers ignore this over plain HTTP and only honor it over a
        # valid HTTPS connection, so it is inert on an IP/HTTP setup and only
        # activates once SSL is enabled. 1 year, current host only (no
        # includeSubdomains/preload to avoid surprising other subdomains).
        stsSeconds: 31536000

    # VPN-only with custom error page
    sentinel_vpn:
      plugin:
        sentinel:
          ipFilter:
            sourceRange:
${VPN_SOURCE_RANGE}
          errorMode: "403"

    # VPN-only silent drop (closes connection silently)
    sentinel_vpn_silent:
      plugin:
        sentinel:
          ipFilter:
            sourceRange:
${VPN_SOURCE_RANGE}
          errorMode: "silent"

    # Firewall block-list — drops visitors whose REAL client IP is on the panel's block
    # list, even behind Cloudflare (matched via CF-Connecting-IP). Silent (no error page).
    # Fail-open: if the list can't be fetched, it blocks no one, so it can't lock you out.
    sentinel_fw_block:
      plugin:
        sentinel:
          ipFilter:
            denyListURL: "http://host.docker.internal:${API_PORT}/internal/blocklist"
            denyCacheTTL: 300
            blockReportURL: "http://host.docker.internal:${API_PORT}/internal/l7block"
          errorMode: "silent"

    # Redirect HTTP to HTTPS (for public domain only)
    redirect-to-https:
      redirectScheme:
        scheme: https
        permanent: true

    # Drop unknown domains (silently closes connection for unconfigured hosts)
    sentinel_drop:
      plugin:
        sentinel:
          ipFilter:
            sourceRange:
              - "0.0.0.0/32"
          errorMode: "silent"

    # Block AI bots and crawlers via robots.txt
    sentinel_robots:
      plugin:
        sentinel:
          robots:
            enabled: true
            listUrl: "https://raw.githubusercontent.com/ai-robots-txt/ai.robots.txt/main/robots.json"
            cacheTTL: 86400
            disallow:
              - "/"

    # Block known crawlers and bots by user-agent
    sentinel_deny_agents:
      plugin:
        sentinel:
          userAgents:
            listUrl: "https://raw.githubusercontent.com/monperrus/crawler-user-agents/master/crawler-user-agents.json"
            cacheTTL: 86400
