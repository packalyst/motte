# Traefik Dynamic Configuration
http:
  routers:
    # Plain HTTP on the server IP / admin domain only redirects to HTTPS (panel, API and
    # /api/v1 alike), so nothing is ever served unencrypted. Kept as "ui": the VPN-only and
    # block-list toggles gate it like the HTTPS routers below.
    ui:
      rule: "(Host(`${SERVER_IP}`) || Host(`${ADMIN_DOMAIN}`)) && PathPrefix(`/`)"
      service: ui
      priority: 10
      middlewares:
        - sentinel_fw_block
        - redirect-to-https  # last: gates added at runtime go ahead of it
      entryPoints:
        - web

    # UI on the server IP / admin domain - HTTPS (Traefik's own self-signed certificate: a
    # bare IP or a VPN-only name can't get a public one)
    ui-ip-secure:
      rule: "(Host(`${SERVER_IP}`) || Host(`${ADMIN_DOMAIN}`)) && PathPrefix(`/`)"
      service: ui
      priority: 10
      middlewares:
        - security-headers
        - sentinel_fw_block
      entryPoints:
        - websecure
      tls: {}

    # Unified API - all /api/* routes (except /api/v1 for headscale direct) - HTTPS. No Traefik
    # rate-limit: the API limits every request itself, per real visitor (behind Cloudflare
    # Traefik would only see Cloudflare's address, so visitors would share one bucket).
    unified-api-ip-secure:
      rule: "(Host(`${SERVER_IP}`) || Host(`${ADMIN_DOMAIN}`)) && PathPrefix(`/api/`) && !PathPrefix(`/api/v1`)"
      service: unified-api
      priority: 100
      middlewares:
        - security-headers
        - sentinel_fw_block
      entryPoints:
        - websecure
      tls: {}

    # Headscale control plane - HTTP (for Tailscale clients; without a domain they use
    # http://SERVER_IP, and their protocol is encrypted itself). Not redirected.
    # Includes /derp for DERP relay connections and /register for node registration
    headscale-control:
      rule: "(Host(`${SERVER_IP}`) || Host(`${ADMIN_DOMAIN}`)) && (PathPrefix(`/ts2021`) || PathPrefix(`/machine`) || PathPrefix(`/key`) || PathPrefix(`/noise`) || PathPrefix(`/derp`) || PathPrefix(`/register`) || PathPrefix(`/apple`) || PathPrefix(`/windows`))"
      service: headscale
      priority: 100
      entryPoints:
        - web

    # Headscale control plane - HTTPS (Tailscale clients try HTTPS first)
    headscale-control-secure:
      rule: "(Host(`${SERVER_IP}`) || Host(`${ADMIN_DOMAIN}`)) && (PathPrefix(`/ts2021`) || PathPrefix(`/machine`) || PathPrefix(`/key`) || PathPrefix(`/noise`) || PathPrefix(`/derp`) || PathPrefix(`/register`) || PathPrefix(`/apple`) || PathPrefix(`/windows`))"
      service: headscale
      priority: 100
      entryPoints:
        - websecure
      tls: {}

    # Headscale API - BLOCKED for external access (UI uses /api/hs via unified API)
    # This prevents direct API access - all admin goes through unified API with server-side auth
    headscale-api-blocked-ip-secure:
      rule: "(Host(`${SERVER_IP}`) || Host(`${ADMIN_DOMAIN}`)) && PathPrefix(`/api/v1`)"
      service: headscale
      priority: 100
      middlewares:
        - sentinel_vpn
        - rate-limit-strict
        - security-headers
      entryPoints:
        - websecure
      tls: {}

    # Block PWA files on non-main domains (prevent Chrome install prompt on other domains)
    block-pwa-catchall:
      rule: "!Host(`${SERVER_IP}`) && !Host(`${ADMIN_DOMAIN}`) && (Path(`/manifest.json`) || Path(`/sw.js`) || Path(`/icon.svg`))"
      service: ui
      priority: 5
      middlewares:
        - sentinel_drop
      entryPoints:
        - web

    block-pwa-catchall-secure:
      rule: "!Host(`${SERVER_IP}`) && !Host(`${ADMIN_DOMAIN}`) && (Path(`/manifest.json`) || Path(`/sw.js`) || Path(`/icon.svg`))"
      service: ui
      priority: 5
      middlewares:
        - sentinel_drop
      entryPoints:
        - websecure
      tls: {}

    # Catchall for unmatched domains - lowest priority
    # Any domain not configured will get dropped silently
    catchall-drop:
      rule: "PathPrefix(`/`)"
      service: ui
      priority: 1
      middlewares:
        - sentinel_drop
      entryPoints:
        - web

    catchall-drop-secure:
      rule: "PathPrefix(`/`)"
      service: ui
      priority: 1
      middlewares:
        - sentinel_drop
      entryPoints:
        - websecure
      tls: {}

  services:
    ui:
      loadBalancer:
        servers:
          - url: "http://ui:80"

    unified-api:
      loadBalancer:
        servers:
          - url: "http://host.docker.internal:${API_PORT}"

    headscale:
      loadBalancer:
        servers:
          - url: "http://headscale:8080"

  middlewares:
    # Rate limiting - requests per second average, burst. For proxied sites that pick it; the
    # panel's own API is limited by the API itself (per real visitor), not here.
    rate-limit:
      rateLimit:
        average: ${RATE_LIMIT_AVERAGE}
        burst: ${RATE_LIMIT_BURST}

    # Strict rate limiting for sensitive APIs
    rate-limit-strict:
      rateLimit:
        average: ${RATE_LIMIT_STRICT_AVERAGE}
        burst: ${RATE_LIMIT_STRICT_BURST}

    # Security headers
    security-headers:
      headers:
        frameDeny: true
        contentTypeNosniff: true
        browserXssFilter: true
        referrerPolicy: "strict-origin-when-cross-origin"
        # Content-Security-Policy: the backstop that neuters XSS. script-src 'self' allows
        # NO inline scripts (the page carries none — the SW registration lives in main.js),
        # so an injected <script> or inline handler is blocked. style-src keeps 'unsafe-inline'
        # (Svelte/Tailwind inject inline styles — not a script-exec vector); img-src allows the
        # Leaflet map tiles and the Leaflet stylesheet's own images (unpkg) and nothing else
        # external; connect-src is the panel itself only ('self' covers its ws:/wss: too).
        # frame-ancestors 'none' is the modern clickjacking guard (matches frameDeny).
        # NOTE: if a bundled lib ever needs eval, add 'unsafe-eval' to script-src.
        # connect-src needs no external host: country flags are served by the panel, and the
        # service worker (public/sw.js) leaves other origins alone, so the Leaflet map tiles load
        # as plain images (img-src). style-src adds unpkg.com for the externally-loaded Leaflet
        # stylesheet.
        contentSecurityPolicy: "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: https://unpkg.com https://*.tile.openstreetmap.org; style-src 'self' 'unsafe-inline' https://unpkg.com; script-src 'self'; connect-src 'self'; font-src 'self' data:"
        # HSTS: browsers ignore this over plain HTTP and only honor it over a
        # valid HTTPS connection, so it is inert on an IP/HTTP setup and only
        # activates once SSL is enabled. 1 year, current host only (no
        # includeSubdomains/preload to avoid surprising other subdomains).
        stsSeconds: 31536000

    # VPN-only with custom error page
    sentinel_vpn:
      plugin:
        sentinel:
          ipFilter:
            sourceRange:
${VPN_SOURCE_RANGE}
          errorMode: "403"
          cloudflareListUrl: "http://host.docker.internal:${API_PORT}/internal/cloudflare"

    # VPN-only silent drop (closes connection silently)
    sentinel_vpn_silent:
      plugin:
        sentinel:
          ipFilter:
            sourceRange:
${VPN_SOURCE_RANGE}
          errorMode: "silent"
          cloudflareListUrl: "http://host.docker.internal:${API_PORT}/internal/cloudflare"

    # Firewall block-list — drops visitors whose REAL client IP is on the panel's block
    # list, even behind Cloudflare (matched via CF-Connecting-IP, trusted only from the
    # panel's live Cloudflare list, cloudflareListUrl). Silent (no error page).
    # Fail-open: if the list can't be fetched, it blocks no one, so it can't lock you out.
    sentinel_fw_block:
      plugin:
        sentinel:
          ipFilter:
            denyListURL: "http://host.docker.internal:${API_PORT}/internal/blocklist"
            denyCacheTTL: 300
            blockReportURL: "http://host.docker.internal:${API_PORT}/internal/l7block"
          errorMode: "silent"
          cloudflareListUrl: "http://host.docker.internal:${API_PORT}/internal/cloudflare"

    # Redirect HTTP to HTTPS (same host and path, on the HTTPS port)
    redirect-to-https:
      redirectScheme:
        scheme: https
        port: "${HTTPS_PORT}"
        permanent: true

    # Port-80 gate (attached to the whole HTTP entry point when a domain is set; see
    # sentinel/gate.go). While Cloudflare-only is on, only Cloudflare and the panel's own
    # networks get past it, plus Let's Encrypt's HTTP challenge; anyone else is dropped
    # silently and reported for the 'webgate' jail. With it off, the panel answers "off".
    sentinel_web_gate:
      plugin:
        sentinel:
          gate:
            listUrl: "http://host.docker.internal:${API_PORT}/internal/webgate"
            cacheTTL: 60
            reportUrl: "http://host.docker.internal:${API_PORT}/internal/webgate/drops"

    # Drop unknown domains (silently closes connection for unconfigured hosts)
    sentinel_drop:
      plugin:
        sentinel:
          ipFilter:
            sourceRange:
              - "0.0.0.0/32"
          errorMode: "silent"

    # Block AI bots and crawlers via robots.txt
    sentinel_robots:
      plugin:
        sentinel:
          robots:
            enabled: true
            listUrl: "https://raw.githubusercontent.com/ai-robots-txt/ai.robots.txt/main/robots.json"
            cacheTTL: 86400
            disallow:
              - "/"

    # Block known crawlers and bots by user-agent
    sentinel_deny_agents:
      plugin:
        sentinel:
          userAgents:
            listUrl: "https://raw.githubusercontent.com/monperrus/crawler-user-agents/master/crawler-user-agents.json"
            cacheTTL: 86400
